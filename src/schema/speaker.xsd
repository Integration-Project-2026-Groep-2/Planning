<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           version="1.0">

  <xs:include schemaLocation="common.xsd"/>

  <xs:element name="PlanningSpeakerCreated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speakerId" type="UUIDType"/>
        <xs:element name="firstName" type="NameType"/>
        <xs:element name="lastName" type="NameType"/>
        <xs:element name="email" type="EmailType"/>
        <xs:element name="phoneNumber" type="xs:string" minOccurs="0"/>
        <xs:element name="company" type="xs:string" minOccurs="0"/>
        <xs:element name="isActive" type="xs:boolean"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="PlanningSpeakerUpdated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speakerId" type="UUIDType"/>
        <xs:element name="firstName" type="NameType"/>
        <xs:element name="lastName" type="NameType"/>
        <xs:element name="email" type="EmailType"/>
        <xs:element name="phoneNumber" type="xs:string" minOccurs="0"/>
        <xs:element name="company" type="xs:string" minOccurs="0"/>
        <xs:element name="isActive" type="xs:boolean"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="PlanningSpeakerDeactivated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speakerId" type="UUIDType"/>
        <xs:element name="email" type="EmailType" minOccurs="0"/>
        <xs:element name="deactivatedAt" type="ISO8601DateTimeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="PlanningSpeakersAll">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speaker" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="speakerId" type="UUIDType"/>
              <xs:element name="firstName" type="NameType"/>
              <xs:element name="lastName" type="NameType"/>
              <xs:element name="email" type="EmailType"/>
              <xs:element name="phoneNumber" type="xs:string" minOccurs="0"/>
              <xs:element name="company" type="xs:string" minOccurs="0"/>
              <xs:element name="isActive" type="xs:boolean"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>