<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ========================================================= -->
  <!-- SpeakerCreated -->
  <!-- Planning → Frontend -->
  <!-- ========================================================= -->

  <xs:element name="SpeakerCreated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speakerId"   type="xs:string"   minOccurs="0"/>
        <xs:element name="firstName"   type="xs:string"/>
        <xs:element name="lastName"    type="xs:string"/>
        <xs:element name="email"       type="xs:string"/>
        <xs:element name="phoneNumber" type="xs:string"   minOccurs="0"/>
        <xs:element name="companyId"     type="xs:string"   minOccurs="0"/>
        <xs:element name="isActive"    type="xs:boolean"  minOccurs="0"/>
        <xs:element name="timestamp"   type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SpeakerUpdated -->
  <!-- Planning → Frontend -->
  <!-- ========================================================= -->

  <xs:element name="SpeakerUpdated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speakerId"   type="xs:string"/>
        <xs:element name="firstName"   type="xs:string"/>
        <xs:element name="lastName"    type="xs:string"/>
        <xs:element name="email"       type="xs:string"/>
        <xs:element name="phoneNumber" type="xs:string"   minOccurs="0"/>
        <xs:element name="companyId"     type="xs:string"   minOccurs="0"/>
        <xs:element name="isActive"    type="xs:boolean"  minOccurs="0"/>
        <xs:element name="timestamp"   type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SpeakerDeactivated -->
  <!-- Planning → Frontend -->
  <!-- ========================================================= -->

  <xs:element name="SpeakerDeactivated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speakerId"    type="xs:string"/>
        <xs:element name="email"        type="xs:string"   minOccurs="0"/>
        <xs:element name="deactivatedAt" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SpeakersRequested -->
  <!-- Frontend → Planning (request-reply) -->
  <!-- ========================================================= -->

  <xs:element name="SpeakersRequested">
    <xs:complexType>
      <xs:sequence/>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SpeakersAll -->
  <!-- Planning → Frontend (request-reply response) -->
  <!-- ========================================================= -->

  <xs:element name="SpeakersAll">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="speakers">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="speaker" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="speakerId"   type="xs:string"/>
                    <xs:element name="firstName"   type="xs:string"/>
                    <xs:element name="lastName"    type="xs:string"/>
                    <xs:element name="email"       type="xs:string"/>
                    <xs:element name="phoneNumber" type="xs:string"  minOccurs="0"/>
                    <xs:element name="companyId"     type="xs:string"  minOccurs="0"/>
                    <xs:element name="isActive"    type="xs:boolean" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
