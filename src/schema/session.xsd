<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ========================================================= -->
  <!-- SessionCreated -->
  <!-- ========================================================= -->

  <xs:element name="SessionCreated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="xs:string"/>
        <xs:element name="title" type="xs:string"/>
        <xs:element name="date" type="xs:string"/>
        <xs:element name="startTime" type="xs:string"/>
        <xs:element name="endTime" type="xs:string" minOccurs="0"/>
        <xs:element name="location" type="xs:string"/>
        <xs:element name="status" type="xs:string"/>
        <xs:element name="capacity" type="xs:int" minOccurs="0"/>
        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
        <xs:element name="timestamp" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SessionUpdated -->
  <!-- ========================================================= -->

  <xs:element name="SessionUpdated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="xs:string"/>
        <xs:element name="sessionName" type="xs:string"/>
        <xs:element name="changeType" type="xs:string"/>
        <xs:element name="newTime" type="xs:string" minOccurs="0"/>
        <xs:element name="newLocation" type="xs:string" minOccurs="0"/>

        <xs:element name="participantIds" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element
                name="participantId"
                type="xs:string"
                minOccurs="0"
                maxOccurs="unbounded"
              />
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
        <xs:element name="timestamp" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SessionCancelled -->
  <!-- ========================================================= -->

  <xs:element name="SessionCancelled">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="xs:string"/>
        <xs:element name="status" type="xs:string" minOccurs="0"/>

        <xs:element name="participantIds" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element
                name="participantId"
                type="xs:string"
                minOccurs="0"
                maxOccurs="unbounded"
              />
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
        <xs:element name="timestamp" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SessionRescheduled -->
  <!-- ========================================================= -->

  <xs:element name="SessionRescheduled">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="xs:string"/>
        <xs:element name="newDate" type="xs:string"/>
        <xs:element name="newStartTime" type="xs:string"/>
        <xs:element name="newEndTime" type="xs:string" minOccurs="0"/>
        <xs:element name="newLocation" type="xs:string" minOccurs="0"/>

        <xs:element name="participantIds" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element
                name="participantId"
                type="xs:string"
                minOccurs="0"
                maxOccurs="unbounded"
              />
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
        <xs:element name="timestamp" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SessionFull -->
  <!-- ========================================================= -->

  <xs:element name="SessionFull">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="xs:string"/>
        <xs:element
          name="currentRegistrations"
          type="xs:int"
          minOccurs="0"
        />
        <xs:element
          name="crmMasterId"
          type="xs:string"
          minOccurs="0"
        />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- ParticipantRegistered -->
  <!-- ========================================================= -->

  <xs:element name="ParticipantRegistered">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="xs:string"/>
        <xs:element
          name="currentRegistrations"
          type="xs:int"
        />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SessionsRequested -->
  <!-- ========================================================= -->

  <xs:element name="SessionsRequested">
    <xs:complexType>
      <xs:sequence/>
    </xs:complexType>
  </xs:element>

  <!-- ========================================================= -->
  <!-- SessionsAll -->
  <!-- ========================================================= -->

  <xs:element name="SessionsAll">
    <xs:complexType>
      <xs:sequence>

        <xs:element name="sessions">
          <xs:complexType>
            <xs:sequence>

              <xs:element
                name="session"
                minOccurs="0"
                maxOccurs="unbounded"
              >
                <xs:complexType>
                  <xs:sequence>

                    <xs:element name="sessionId" type="xs:string"/>
                    <xs:element name="title" type="xs:string"/>
                    <xs:element name="date" type="xs:string"/>
                    <xs:element name="startTime" type="xs:string"/>

                    <xs:element
                      name="endTime"
                      type="xs:string"
                      minOccurs="0"
                    />

                    <xs:element
                      name="location"
                      type="xs:string"
                      minOccurs="0"
                    />

                    <xs:element
                      name="locationId"
                      type="xs:string"
                      minOccurs="0"
                    />

                    <xs:element
                      name="speakerId"
                      type="xs:string"
                      minOccurs="0"
                    />

                    <xs:element
                      name="status"
                      type="xs:string"
                      minOccurs="0"
                    />

                    <xs:element
                      name="capacity"
                      type="xs:int"
                      minOccurs="0"
                    />

                    <xs:element
                      name="icsData"
                      type="xs:string"
                      minOccurs="0"
                    />

                    <xs:element
                      name="timestamp"
                      type="xs:dateTime"
                      minOccurs="0"
                    />

                  </xs:sequence>
                </xs:complexType>
              </xs:element>

            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>