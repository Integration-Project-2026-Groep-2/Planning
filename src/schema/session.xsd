<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           version="1.0">

  <xs:include schemaLocation="common.xsd"/>

  <xs:element name="SessionCreated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="UUIDType"/>
        <xs:element name="title" type="xs:string"/>
        <xs:element name="date" type="xs:date"/>
        <xs:element name="startTime" type="xs:time"/>
        <xs:element name="endTime" type="xs:time"/>
        <xs:element name="location" type="xs:string"/>
        <xs:element name="status" type="SessionStatusType"/>
        <xs:element name="capacity" type="PositiveIntType"/>
        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="SessionUpdated">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="UUIDType"/>
        <xs:element name="sessionName" type="xs:string"/>
        <xs:element name="changeType" type="ChangeTypeType"/>
        <xs:element name="newTime" type="ISO8601DateTimeType" minOccurs="0"/>
        <xs:element name="newLocation" type="xs:string" minOccurs="0"/>
        <xs:element name="participantIds" type="ParticipantIdsType" minOccurs="0"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="SessionCancelled">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="UUIDType"/>
        <xs:element name="sessionName" type="xs:string" minOccurs="0"/>
        <xs:element name="status" type="SessionStatusType"/>
        <xs:element name="reason" type="xs:string" minOccurs="0"/>
        <xs:element name="participantIds" type="ParticipantIdsType" minOccurs="0"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="SessionRescheduled">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="UUIDType"/>
        <xs:element name="sessionName" type="xs:string"/>
        <xs:element name="oldDate" type="xs:date"/>
        <xs:element name="oldStartTime" type="xs:time"/>
        <xs:element name="oldEndTime" type="xs:time"/>
        <xs:element name="newDate" type="xs:date"/>
        <xs:element name="newStartTime" type="xs:time"/>
        <xs:element name="newEndTime" type="xs:time"/>
        <xs:element name="newLocation" type="xs:string" minOccurs="0"/>
        <xs:element name="reason" type="xs:string" minOccurs="0"/>
        <xs:element name="participantIds" type="ParticipantIdsType" minOccurs="0"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
        <xs:element name="icsData" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="SessionFull">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="UUIDType"/>
        <xs:element name="currentRegistrations" type="xs:nonNegativeInteger"/>
        <xs:element name="capacity" type="PositiveIntType" minOccurs="0"/>
        <xs:element name="crmMasterId" type="UUIDType" minOccurs="0"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="SessionError">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="errorType" type="ErrorTypeType"/>
        <xs:element name="message" type="xs:string"/>
        <xs:element name="sessionId" type="UUIDType" minOccurs="0"/>
        <xs:element name="service" type="xs:string" minOccurs="0"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ParticipantRegistered">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sessionId" type="UUIDType"/>
        <xs:element name="crmMasterId" type="UUIDType" minOccurs="0"/>
        <xs:element name="currentRegistrations" type="xs:nonNegativeInteger"/>
        <xs:element name="capacity" type="PositiveIntType" minOccurs="0"/>
        <xs:element name="registrationTime" type="ISO8601DateTimeType" minOccurs="0"/>
        <xs:element name="timestamp" type="ISO8601DateTimeType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="PlanningSessionsAll">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="session" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sessionId" type="UUIDType"/>
              <xs:element name="title" type="xs:string"/>
              <xs:element name="date" type="xs:date"/>
              <xs:element name="startTime" type="xs:time"/>
              <xs:element name="endTime" type="xs:time"/>
              <xs:element name="location" type="xs:string" minOccurs="0"/>
              <xs:element name="status" type="SessionStatusType"/>
              <xs:element name="capacity" type="PositiveIntType"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>